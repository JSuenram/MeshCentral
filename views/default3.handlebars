                    '<div>';

            // Password toggle
            x += '<div style="margin-top:8px;">' +
                    '<label style="font-weight: normal;">' +
                        '<input type="checkbox" id="d2typeMask" style="margin-right:5px;">' +
                        'Hide Input' +
                    '</label>' +
                 '</div>';

            // Clear text area shown by default
            x += '<div id="d2clearWrapper" style="margin-top:5px;">' +
                    '<textarea id="d2typeText" style="width:100%;height:140px;resize:none" maxlength=2000>' +
                        (text ? EscapeHtml(text) : '') +
                    '</textarea>' +
                 '</div>';

            // Password field hidden until the checkbox is selected
            x += '<div id="d2passWrapper" style="margin-top:5px;display:none;">' +
                    '<input type="password" id="d2typePass" style="width:100%;height:28px;" maxlength=2000 value="' +
                        (text ? EscapeHtml(text) : '') +
                    '">' +
                 '</div>';


            // Focus the clear text field by default

            // Small timeout so the elements exist before registering events
            setTimeout(() => {
                Q('d2typeMask').addEventListener('change', function () {
                    if (this.checked) {
                        // Switching to password mode
                        Q('d2typePass').value = Q('d2typeText').value;
                        Q('d2clearWrapper').style.display = 'none';
                        Q('d2passWrapper').style.display = 'block';
                        Q('d2typePass').focus();
                    } else {
                        // Back to clear text mode
                        Q('d2typeText').value = Q('d2typePass').value;
                        Q('d2passWrapper').style.display = 'none';
                        Q('d2clearWrapper').style.display = 'block';
                        Q('d2typeText').focus();
                    }
                });
            }, 50);
            if (typeof text == 'string') {
                txt = text;
